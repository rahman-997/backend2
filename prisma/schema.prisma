generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum OutboxStatus {
  PENDING
  ENQUEUED
  SENT
  FAILED
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(ATTENDEE)
  createdAt     DateTime       @default(now())
  events        Event[]
  bookings      Booking[]
  refreshTokens RefreshToken[]
}

model Event {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  description String
  venue       String
  startsAt    DateTime
  capacity    Int
  priceCents  Int
  organizerId String    @db.Uuid
  createdAt   DateTime  @default(now())
  organizer   User      @relation(fields: [organizerId], references: [id])
  bookings    Booking[]

  @@index([startsAt])
  @@index([organizerId, startsAt])
}

model Booking {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  eventId   String        @db.Uuid
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  event     Event         @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId, status, createdAt])
}

model RefreshToken {
  id           String        @id @default(uuid(7)) @db.Uuid
  tokenHash    String        @unique
  userId       String        @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?       @unique @db.Uuid
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  replacedBy   RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshRotation")

  @@index([userId])
  @@index([expiresAt])
}

model NotificationOutbox {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  enqueuedAt  DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([status, enqueuedAt])
}
